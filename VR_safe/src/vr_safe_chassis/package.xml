<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vr_safe_chassis</name>
  <version>0.1.0</version>
  <description>VR_safe AMR 底盘执行端：遥控、许可门、零速 keepalive、状态/里程计。</description>
  <maintainer email="zwt@example.com">zwt</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>vr_safe_interfaces</exec_depend>
  <exec_depend>vr_safe_chassis_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- 只有非 dry_run 模式才 import；无 AMR 测试不依赖该包。 -->
  <exec_depend>sros-sdk-py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
